APP_NAME="GiMtradefin Hub API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.gimtradefin.com

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gimtradefin_hub
DB_USERNAME=
DB_PASSWORD=

# Frontend origin allowed to call this API
SANCTUM_STATEFUL_DOMAINS=hub.gimtradefin.com,app.gimtradefin.com
FRONTEND_URL=https://app.gimtradefin.com

# Mail — required for password reset emails to actually send.
# MAIL_MAILER=log delivers nowhere but writes to storage/logs/laravel.log,
# useful for local testing. Set real SMTP credentials before production.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@gimtradefin.com
MAIL_FROM_NAME="${APP_NAME}"

# AI Engine — added in Phase 5, not required for Phase 1-2
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
